# Copy to .env and fill in. Never commit .env. Keys live ONLY here (environment variables); the UI never asks for or shows them.

# --- Who may sign in (see docs/github-oauth-setup.md for the OAuth app) -------------------------------------
PUBLIC_URL=https://code-report.example.com          # the address people open (https in production)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUDIT_SESSION_SECRET=                               # long random string; changing it signs everyone out
GITHUB_ORG=your-github-org                          # org members who are collected people get the "self" view
ADMIN_USERS=github-login-1,github-login-2           # admins: run jobs, manage repos/models/skill/people
# VIEWER_USERS=github-login-3                       # read-only, everyone's data
VIEWER_PASSWORD=                                    # shared read-only password for the office TV (/?kiosk=1)

# Local / scripts only (HTTP Basic, treated as admin). Not needed when GitHub sign-in is set up.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=change-me

# --- Collecting from GitHub (read-only token: Contents, Pull requests, Metadata, Commit statuses) -------------
GITHUB_TOKEN=

# --- Scoring with the LLM (pay per use). Models and effort are chosen per case in the UI (Skill & models) ------
ANTHROPIC_API_KEY=
# AUDIT_CONCURRENCY=3                               # scoring calls in flight at once (max 8)

# --- Server ---------------------------------------------------------------------------------------------------
PORT=8765                                           # host port for docker compose
# AUDIT_READONLY=1                                  # viewing-only server (no jobs / admin changes)
