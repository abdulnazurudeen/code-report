# Copy this file to .env and fill it in:   cp .env.example .env      (Windows: copy .env.example .env)
# .env is never committed. Keys live ONLY here: the app shows "set / not set" but never shows or accepts a key.
# Lines that start with # are comments. Put no comment after a value on the same line.
# The values below are placeholders showing the format: replace each one, or delete the line you don't need.
#
# What you must fill in:        GITHUB_TOKEN, GITHUB_ORG   (to collect data)
# To score with the LLM:        ANTHROPIC_API_KEY
# For a hosted team server:     the "Sign-in" block (GitHub OAuth app, admins, optional TV password)
# Everything else is optional.

# ---------------------------------------------------------------- 1. Collecting data from GitHub
# Read-only token with: Contents, Pull requests, Metadata, Commit statuses. (Locally the app also reads a .github_token file.)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your GitHub organisation name, as in github.com/<this>. Used for the repo picker and the org check at sign-in.
GITHUB_ORG=your-github-org

# ---------------------------------------------------------------- 2. Scoring with the LLM (pay per use)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Scoring calls in flight at once (1 to 8)
AUDIT_CONCURRENCY=3

# ---------------------------------------------------------------- 3. Keep the data up to date automatically
# Set the hours between automatic refreshes. Leave it out (or 0) to refresh only when you press Run.
# Needs GITHUB_TOKEN and GITHUB_ORG (or some Tracked repos). You can also change it in the app: Repos > Automatic refresh.
AUTO_REFRESH_HOURS=6
# How far back each automatic run looks (months). 1 is enough once the history is loaded.
AUTO_REFRESH_MONTHS=1
# What to do after collecting: none = collect only (free), heuristic = free rule-based estimate, llm = score with the API key
AUTO_SCORE=none
# Spend cap in USD for one automatic run when AUTO_SCORE=llm
AUTO_MAX_USD=5

# ---------------------------------------------------------------- 4. Sign-in (needed on a hosted server)
# Create the GitHub OAuth app first: docs/github-oauth-setup.md
# The address people open (https in production)
PUBLIC_URL=https://code-report.example.com
GITHUB_OAUTH_CLIENT_ID=Iv1.0123456789abcdef
GITHUB_OAUTH_CLIENT_SECRET=0123456789abcdef0123456789abcdef01234567
# A long random string that signs login cookies. Make one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUDIT_SESSION_SECRET=change-me-to-a-long-random-string
# GitHub logins (comma separated) that are admins: they can run jobs and change settings
ADMIN_USERS=your-github-login,another-admin
# GitHub logins that may view everyone's data, read-only (optional)
VIEWER_USERS=
# Shared read-only password for the office TV (optional). Open /login, or /?kiosk=1 after signing in
VIEWER_PASSWORD=choose-a-tv-password

# ---------------------------------------------------------------- 5. Server
# Port on your machine
PORT=8765
# Where the database file is (the Docker image already sets /data/audit.db)
# AUDIT_DB=/data/audit.db
# Set to 1 for a viewing-only server (no jobs, no changes)
# AUDIT_READONLY=1
