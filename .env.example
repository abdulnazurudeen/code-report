# Copy to .env and fill in. Never commit .env.

# --- Dashboard login (required when the dashboard is reachable from other machines)
# One shared login:
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-to-a-long-random-password
# ...or several people: DASHBOARD_USERS=alice:pw1,bob:pw2
# Put HTTPS in front (reverse proxy / cloud load balancer): Basic auth over plain HTTP is not safe on the internet.

# Open the database read-only (a pure viewing server that never runs collect/score):
# AUDIT_READONLY=1

# Host port for docker compose
PORT=8765

# --- Refreshing data (collect + score). Read-only GitHub token: Contents, Pull requests, Metadata, Commit statuses
GITHUB_TOKEN=
GITHUB_ORG=your-github-org
AUDIT_MONTHS=3

# --- Optional: LLM scoring through the Anthropic API (score --engine anthropic). Pay per use.
ANTHROPIC_API_KEY=
# AUDIT_MODEL=claude-opus-5-5
# AUDIT_EFFORT=high
